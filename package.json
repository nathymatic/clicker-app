{
  "main": "electron/main.js",
  "name": "practice-electron",
  "productName": "Practice Electron",
  "description": "A simple desktop clicker application.",
  "author": "Jay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --external:electron --outfile=electron/main.js",
    "electron:dev": "npm run build:electron && wait-on http://localhost:5173 && electron .",
    "start": "concurrently -k \"vite\" \"npm:electron:dev\"",
    "package": "electron-forge package",
    "make": "npm run build && npm run build:electron && electron-forge make",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-forge-maker-appimage": "^26.18.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
